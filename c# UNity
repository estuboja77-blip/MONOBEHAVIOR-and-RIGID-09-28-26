void HandleInput()
{
Vector3 direction = Vector3.zero

if(input.GetKeyDown(KeyCode.W) direction = Vector 3.up;
else if (Input.GetKeyDown(KeyCode.S)) direction = Vector3.down;
else if (Input.GetKeyDown(KeyCode.S)) direction = Vector3.left;
else if (Input.GetKeyDown(KeyCode.S)) direction = Vector3.right;

if(direction ! = Vector3.zero)
{
targetPosition = transform.position + direction * tileSize;
isMoving = true;
